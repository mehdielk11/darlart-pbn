{
  "name": "paint-by-numbers-generator",
  "version": "1.0.0",
  "description": "Paint by numbers generator",
  "bin": "./src-cli/main.js",
  "scripts": {
    "lite": "lite-server --port 10001",
    "start": "npm run lite",
    "build:frontend": "tsc -p src",
    "build": "node build.js",
    "build:webpack": "webpack --mode production",
    "vercel-build": "npm run build:frontend && npm run build",
    "build:server": "tsc -p server",
    "start:server": "node server/dist/server/src/index.js",
    "test": "npm run build:server && node --test test/core.test.js",
    "prepare:mockups": "npm run build:server && node server/scripts/prepare-mockups.js"
  },
  "author": "drake7707",
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/preset-env": "^7.28.3",
    "@types/node": "^22.20.2",
    "babel-loader": "^10.0.0",
    "html-webpack-plugin": "^5.6.4",
    "javascript-obfuscator": "^4.1.1",
    "lite-server": "^1.3.1",
    "terser": "^5.44.0",
    "terser-webpack-plugin": "^5.3.14",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-obfuscator": "^3.5.1"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@types/jquery": "^3.3.31",
    "@types/materialize-css": "^1.0.6",
    "@types/minimist": "^1.2.0",
    "fastify": "^5.12.4",
    "jspdf": "^4.2.1",
    "minimist": "^1.2.3",
    "sharp": "^0.35.4",
    "svg2img": "^1.0.0-beta.2"
  },
  "engines": {
    "node": "22.x"
  }
}
