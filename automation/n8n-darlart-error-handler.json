    {
      "id": "ee000002-0000-4000-8000-000000000000",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "set0",
              "name": "telegramChatId",
              "value": "-5252292447",
