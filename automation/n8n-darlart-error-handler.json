    },
    {
      "id": "ee000003-0000-4000-8000-000000000000",
      "name": "Error details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// What failed, where, and the run's execution id (its lock is named <prefix>-<execution id>)\nconst e = $('Error Trigger').first().json;\nconst execution = e.execution || {};\nconst workflow = e.workflow || {};\nconst triggerError = (e.trigger && e.trigger.error) || null;\nreturn [{ json: {\n    executionId: execution.id ? String(execution.id) : \"\",\n    workflowId: String(workflow.id || \"\"),\n    workflowName: workflow.name || \"A workflow\",\n    step: execution.lastNodeExecuted || (triggerError && triggerError.node && triggerError.node.name) || \"\",\n    message: (execution.error && execution.error.message) || (triggerError && triggerError.message) || \"unknown error\",\n    url: execution.url || \"\",\n} }];"
      }
    },
    {
      "id": "ee000004-0000-4000-8000-000000000000",
      "name": "Find locks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "url": "https://www.googleapis.com/drive/v3/files",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "(name contains '_artwork-worker.lock' or name contains '_titling-agent.lock' or name contains '_print-agent.lock' or name contains '_shopify-uploader.lock') and trashed = false"
            },
            {
              "name": "fields",
              "value": "files(id,name)"
            },
            {
              "name": "pageSize",
              "value": "1000"
            },
            {
              "name": "supportsAllDrives",
              "value": "true"
            },
            {
              "name": "includeItemsFromAllDrives",
              "value": "true"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "ee000005-0000-4000-8000-000000000000",
      "name": "Locks of the run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "// Only the failed run's own lock: its name ends with \"-<execution id>\"\nconst id = $('Error details').first().json.executionId;\nconst locks = id ? ($input.first().json.files || []).filter((f) => f.name.endsWith(\"-\" + id)) : [];\nreturn locks.length ? locks.map((f) => ({ json: { id: f.id, name: f.name } })) : [{ json: { none: true } }];"
      }
    },
    {
      "id": "ee000006-0000-4000-8000-000000000000",
      "name": "Any lock?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "Anylock",
              "leftValue": "={{ !$json.none }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "executeOnce": true
    },
    {
      "id": "ee000007-0000-4000-8000-000000000000",
      "name": "Delete the run's lock",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -80
      ],
      "parameters": {
        "method": "DELETE",
        "url": "=https://www.googleapis.com/drive/v3/files/{{ $json.id }}?supportsAllDrives=true",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {
          "timeout": 30000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "ee000008-0000-4000-8000-000000000000",
      "name": "Locks to delete",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1210,
        -200
      ],
      "parameters": {
        "jsCode": "return $('Locks of the run').all().filter((item) => !item.json.none).map((item) => ({ json: item.json }));"
      },
      "executeOnce": true
    },
    {
      "id": "ee000009-0000-4000-8000-000000000000",
      "name": "Next steps",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "jsCode": "// What happens now, for the alert; the worker is started again only after a failure past its recorded try\nconst d = $('Error details').first().json;\nconst W = {\"worker\":\"dO8EdyDM4ua2hRrA\",\"form\":\"SLFvTtBEdGfSbgGu\",\"titling\":\"tOSHbCt7hJ6ORh8a\",\"print\":\"ytxV3m341mDLCdt4\",\"uploader\":\"XAwk67SiWmvVSu1d\"};\nconst beforeTry = [\"Settings\",\"List locks\",\"Lock state\",\"Lock free?\",\"Create lock\",\"List locks again\",\"Won the lock?\",\"Lock won?\",\"Step back (drop my lock)\",\"Busy: try again?\",\"Retry?\",\"Wait before retry\",\"List queue\",\"Next reference\",\"Anything queued?\",\"Has manifest?\",\"Download manifest\",\"Start attempt\",\"Record the try?\",\"Save manifest (try)\"];\nconst released = $('Locks to delete').isExecuted ? $('Locks to delete').all().length : 0;\nlet next = \"\";\nlet restartWorker = false;\nif (d.workflowId === W.worker) {\n    if (d.step && !beforeTry.includes(d.step)) {\n        restartWorker = true;\n        next = \"The worker starts again: this reference is retried, and set aside in Artwork Ref/Failed after 3 failed runs.\";\n    } else {\n        next = \"The worker stopped before painting: fix the cause, then click Run now in the Artwork Worker (the queue is kept).\";\n    }\n} else if (d.workflowId === W.print) next = \"The next run (after the next artwork, or daily at 04:00) retries the unfinished folders.\";\nelse if (d.workflowId === W.titling) next = \"The next run (after the next artwork, or daily at 03:00) retries the folders without product texts.\";\nelse if (d.workflowId === W.uploader) next = \"The next run (after the next Print Agent run, or daily at 05:00) retries this folder.\";\nelse if (d.workflowId === W.form) next = \"This upload may not be queued: check Artwork Ref/Queue, and send the images again if they are missing.\";\nconst lines = [\n    \"Workflow failed: \" + d.workflowName,\n    d.step ? \"Step: \" + d.step : \"\",\n    \"Error: \" + String(d.message).slice(0, 600),\n    released ? \"Its queue lock was released, so the next runs are not blocked.\" : \"\",\n    next,\n    d.url,\n].filter(Boolean);\nreturn [{ json: { restartWorker, text: lines.join(\"\\n\") } }];"
      },
      "executeOnce": true
    },
    {
      "id": "ee000010-0000-4000-8000-000000000000",
