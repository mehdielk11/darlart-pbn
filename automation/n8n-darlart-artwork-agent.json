    {
      "id": "aa000003-0000-4000-8000-000000000000",
      "name": "Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// The uploaded image becomes the \"reference\" file, and the run gets its date+time stamp\nconst settings = $('Settings').first().json;\nconst binary = $('Formulaire').first().binary || {};\nconst key = Object.keys(binary)[0];\nif (!key) throw new Error(\"No image in the form submission\");\nconst file = binary[key];\nconst extension = ((file.fileName || \"\").match(/\\.([a-z0-9]+)$/i) || [, (file.fileExtension || \"jpg\")])[1].toLowerCase();\nconst stamp = $now.setZone(settings.timezone).toFormat(\"yyyy-MM-dd_HH-mm-ss\");\nreturn [{\n    json: {\n        stamp,\n        referenceName: stamp + \"_ref.\" + extension,\n        artworkName: stamp + \"_art.png\",\n        paletteName: stamp + \"_palette.json\",\n    },\n    binary: { reference: file },\n}];"
      }
    },
    {
      "id": "aa000004-0000-4000-8000-000000000000",
      "name": "Save reference (Artwork Ref)",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        660,
        0
      ],
      "parameters": {
        "name": "={{ $('Prepare').first().json.referenceName }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Settings').first().json.refFolderId }}"
        },
        "inputDataFieldName": "reference",
        "options": {}
      }
    },
    {
      "id": "aa000005-0000-4000-8000-000000000000",
      "name": "Build image prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "// A fixed prompt: the model sees the reference itself (high input fidelity), so no scene description is needed\nconst imagePrompt = [\n    \"Repaint this image as a highly detailed digital painting in flat cel-shaded color, like a fine gouache or screen-print illustration made for a paint-by-numbers canvas.\",\n    \"Keep everything from the image exactly: the same subjects, likeness, expressions, poses, objects, background and framing, with realistic proportions.\",\n    \"Keep the original colors of the image.\",\n    \"Each area is painted in flat solid tones with crisp, clean, smooth edges, and shading is built from distinct flat tone steps.\",\n    \"Preserve every fine detail: facial features, eyes, lips, fingers, hair strands, clothing folds, individual leaves, reflections, architecture.\",\n    \"Smooth high-resolution shapes, not pixel art, no blocks, no mosaic, no gradients, no blur, no texture, no grain, no brush strokes, no outlines.\",\n    \"The painting fills the entire image edge to edge. Do not add anything to the image: no color bar, no swatches, no palette, no legend, no labels, no text, no numbers, no border, no margin.\",\n].join(\"\\n\");\nreturn [{ json: { imagePrompt }, binary: $('Prepare').first().binary }];"
      }
    },
    {
      "id": "aa000006-0000-4000-8000-000000000000",
