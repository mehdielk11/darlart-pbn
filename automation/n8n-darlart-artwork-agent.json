    {
      "id": "aa000018-0000-4000-8000-000000000000",
      "name": "List Artwork Agent folders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2740,
        -200
      ],
      "parameters": {
        "url": "https://www.googleapis.com/drive/v3/files",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "='{{ $('Settings').first().json.agentFolderId }}' in parents and mimeType = 'application/vnd.google-apps.folder' and trashed = false"
            },
            {
              "name": "fields",
              "value": "files(id,name)"
            },
            {
              "name": "pageSize",
              "value": "1000"
            },
            {
              "name": "supportsAllDrives",
              "value": "true"
            },
            {
              "name": "includeItemsFromAllDrives",
              "value": "true"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "aa000019-0000-4000-8000-000000000000",
      "name": "Next folder number",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2960,
        -200
      ],
      "parameters": {
        "jsCode": "// The new folder is the next free number: 1001, 1002, ... (folders with other names are ignored)\nconst first = Number($('Settings').first().json.firstFolderNumber) || 1001;\nconst numbers = (($input.first().json.files) || []).map((f) => String(f.name).trim()).filter((n) => /^\\d+$/.test(n)).map(Number);\nconst next = numbers.length ? Math.max(first - 1, ...numbers) + 1 : first;\nreturn [{ json: { folderName: String(next) } }];"
      }
    },
    {
      "id": "aa000020-0000-4000-8000-000000000000",
      "name": "Create folder (Artwork Agent/1xxx)",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        3180,
        -200
      ],
      "parameters": {
        "resource": "folder",
        "name": "={{ $json.folderName }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Settings').first().json.agentFolderId }}"
        },
        "options": {}
      }
    },
    {
      "id": "aa000021-0000-4000-8000-000000000000",
      "name": "Files for the folder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3400,
        -200
      ],
      "parameters": {
        "jsCode": "// Artwork Ref + Artwork Gen (+ the palette JSON), one item per file\nconst folderId = $input.first().json.id;\nconst prepared = $('Prepare').first();\nconst paletteJson = $('Check palette').first().json.paletteJson;\nreturn [\n    { json: { folderId, name: prepared.json.referenceName }, binary: { data: prepared.binary.reference } },\n    { json: { folderId, name: prepared.json.artworkName }, binary: { data: $('Artwork file').first().binary.artwork } },\n    {\n        json: { folderId, name: prepared.json.paletteName },\n        binary: { data: { data: Buffer.from(JSON.stringify(paletteJson, null, 2)).toString(\"base64\"), mimeType: \"application/json\", fileName: prepared.json.paletteName } },\n    },\n];"
      }
    },
    {
      "id": "aa000022-0000-4000-8000-000000000000",
      "name": "Upload to folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        3620,
        -200
      ],
      "parameters": {
        "name": "={{ $json.name }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.folderId }}"
        },
        "inputDataFieldName": "data",
        "options": {}
      }
    },
    {
      "id": "aa000023-0000-4000-8000-000000000000",
      "name": "Build result page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3840,
        -200
      ],
      "parameters": {
        "jsCode": "// Result: 1xxx = Artwork Ref + Artwork Gen, shown on the form's last page\nconst folder = $('Create folder (Artwork Agent/1xxx)').first().json;\nconst paletteJson = $('Check palette').first().json.paletteJson;\nconst png = \"data:image/png;base64,\" + $('Check palette').first().json.image;\nconst folderUrl = \"https://drive.google.com/drive/folders/\" + folder.id;\nconst esc = (s) => String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\");\nconst swatches = paletteJson.colors.map((c) => '<span class=\"sw\" title=\"' + esc(c.code + \" \" + c.hex + \" \" + c.percent + \"%\") + '\" style=\"background:' + c.hex + '\"></span>').join(\"\");\nconst html = `<style>\n  .r{font-family:system-ui,sans-serif;max-width:960px;margin:0 auto;text-align:left;color:#1d2433}\n  .r img{width:100%;height:auto;border-radius:10px;display:block}\n  .r h2{margin:18px 0 6px;font-size:22px}\n  .r .b{display:inline-block;padding:10px 16px;border-radius:8px;background:#1d2433;color:#fff;text-decoration:none;margin:0 8px 14px 0}\n  .r .sw{display:inline-block;width:22px;height:22px;border-radius:4px;margin:0 4px 4px 0;border:1px solid #0002}\n  .r pre{background:#f3f4f6;padding:12px;border-radius:8px;overflow:auto;max-height:320px;font-size:12px}\n</style>\n<div class=\"r\">\n  <img src=\"${png}\" alt=\"Artwork ${esc(folder.name)}\">\n  <h2>Artwork ${esc(folder.name)}: ${paletteJson.colorCount} Darl'Art colors</h2>\n  <a class=\"b\" href=\"${folderUrl}\" target=\"_blank\">Open Drive folder ${esc(folder.name)}</a>\n  <a class=\"b\" href=\"${png}\" download=\"${esc(paletteJson.artwork)}\">Download artwork</a>\n  <div>${swatches}</div>\n  <pre>${esc(JSON.stringify(paletteJson.colors.map((c) => ({ code: c.code, hex: c.hex, percent: c.percent })), null, 1))}</pre>\n</div>`;\nreturn [{ json: { html, folder: folder.name, folderUrl } }];"
      },
      "executeOnce": true
    },
    {
      "id": "aa000024-0000-4000-8000-000000000000",
