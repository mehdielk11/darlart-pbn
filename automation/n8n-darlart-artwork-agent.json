    {
      "id": "aa000016-0000-4000-8000-000000000000",
      "name": "Check palette",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2300,
        -200
      ],
      "parameters": {
        "jsCode": "// Every pixel of the final artwork is a Darl'Art color: check the count and the codes before saving\nconst PALETTE = {\"1001\":\"#F5FAC4\",\"1002\":\"#EBF5B0\",\"1003\":\"#DFF39E\",\"1004\":\"#D3F191\",\"1005\":\"#CCEE8D\",\"1006\":\"#C3E87E\",\"1007\":\"#BAE476\",\"1008\":\"#B0DD66\",\"1009\":\"#A2D959\",\"1010\":\"#97D147\",\"1011\":\"#6A7042\",\"1012\":\"#555A35\",\"1013\":\"#404328\",\"1014\":\"#30321E\",\"1015\":\"#222415\",\"1101\":\"#EBFFCC\",\"1102\":\"#DAF9B5\",\"1103\":\"#CCF3A2\",\"1104\":\"#BFED93\",\"1105\":\"#B0E78A\",\"1106\":\"#A6DF7E\",\"1107\":\"#9ADC72\",\"1108\":\"#8ED366\",\"1109\":\"#82D15C\",\"1110\":\"#6EC449\",\"1111\":\"#597B3E\",\"1112\":\"#476232\",\"1113\":\"#354A25\",\"1114\":\"#28371C\",\"1115\":\"#1C2714\",\"1201\":\"#D5F6C9\",\"1202\":\"#C1EEB3\",\"1203\":\"#B3E8A4\",\"1204\":\"#A4E297\",\"1205\":\"#ACF393\",\"1206\":\"#A0E885\",\"1207\":\"#96E57C\",\"1208\":\"#8DE074\",\"1209\":\"#77D364\",\"1210\":\"#60C752\",\"1211\":\"#527A45\",\"1212\":\"#426237\",\"1213\":\"#314929\",\"1214\":\"#25371F\",\"1215\":\"#1A2716\",\"1301\":\"#BFEFD9\",\"1302\":\"#A4E4BF\",\"1303\":\"#96DFB2\",\"1304\":\"#85D8A2\",\"1305\":\"#85D691\",\"1306\":\"#7CCF87\",\"1307\":\"#71C97F\",\"1308\":\"#5CBF6C\",\"1309\":\"#4CB862\",\"1310\":\"#2EA555\",\"1311\":\"#336C4C\",\"1312\":\"#29563D\",\"1313\":\"#1F412E\",\"1314\":\"#173122\",\"1315\":\"#102318\",\"1401\":\"#B9F1D6\",\"1402\":\"#9FE7C2\",\"1403\":\"#8CDFB5\",\"1404\":\"#7AD5AA\",\"1405\":\"#68CC9A\",\"1406\":\"#5DC391\",\"1407\":\"#4EBB84\",\"1408\":\"#41B47B\",\"1409\":\"#23A565\",\"1410\":\"#079A53\",\"1411\":\"#166D43\",\"1412\":\"#125736\",\"1413\":\"#0D4128\",\"1414\":\"#0A311E\",\"1415\":\"#072315\",\"1501\":\"#ADEFD4\",\"1502\":\"#8EE2C8\",\"1503\":\"#79D6B7\",\"1504\":\"#66CDAF\",\"1505\":\"#57C69B\",\"1506\":\"#4CC093\",\"1507\":\"#3DB285\",\"1508\":\"#26A97D\",\"1509\":\"#02946D\",\"1510\":\"#028B5F\",\"1511\":\"#04634D\",\"1512\":\"#034F3E\",\"1513\":\"#023B2E\",\"1514\":\"#02