      "parameters": {
        "jsCode": "// ===== Settings =====\nconst DEFAULT_COLORS = 24;\nconst ALLOWED_COLORS = [12, 24, 36, 48];\n// ====================\n\n// The uploaded photo becomes the \"reference\" file, whatever the form field is called\nconst item = $input.first();\nconst binary = item.binary || {};\nconst key = Object.keys(binary)[0];\nif (!key) throw new Error(\"No photo in the form submission\");\nconst colors = Number(String(item.json.Colors || \"\").replace(/\\D/g, \"\")) || DEFAULT_COLORS;\nreturn [{\n    json: { colors: ALLOWED_COLORS.includes(colors) ? colors : DEFAULT_COLORS, fileName: binary[key].fileName || \"photo\" },\n    binary: { reference: binary[key] },\n}];"
      },
