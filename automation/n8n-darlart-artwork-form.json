        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"palette\": {\n      \"type\": \"array\",\n      \"description\": \"Exactly N distinct Darl'Art colors, largest area first\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\",\n            \"description\": \"4-digit Darl'Art ID, e.g. 2101\"\n          },\n          \"hex\": {\n            \"type\": \"string\",\n            \"description\": \"Exact HEX of that ID, e.g. #32B5E9\"\n          },\n          \"use\": {\n            \"type\": \"string\",\n            \"description\": \"Where the color goes\"\n          }\n        },\n        \"required\": [\n          \"id\",\n          \"hex\",\n          \"use\"\n        ]\n      }\n    },\n    \"scene\": {\n      \"type\": \"string\"\n    },\n    \"orientation\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"landscape\",\n        \"portrait\",\n        \"square\"\n      ]\n    },\n    \"title\": {\n      \"type\": \"string\"\n    },\n    \"description\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"palette\",\n    \"scene\",\n    \"orientation\",\n    \"title\",\n    \"description\"\n  ]\n}"
      },
