    {
      "id": "bb000032-0000-4000-8000-000000000000",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        -40
      ],
      "parameters": {
        "jsCode": "// What this run produced (visible in the execution log)\nconst saved = $input.all().map((item) => item.json.name).filter(Boolean);\nreturn [{ json: { saved: saved.length, files: saved } }];"
      }
    },
    {
      "id": "bb000033-0000-4000-8000-000000000000",
      "name": "Locks to delete",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        -420
      ],
      "parameters": {
        "jsCode": "// My lock, plus locks left behind by crashed runs\nconst processed = $('Summary').isExecuted && $('Summary').first().json.saved > 0;\nconst ids = [$('Won the lock?').first().json.lockId, ...$('Lock state').first().json.stale];\nreturn ids.map((id) => ({ json: { id, processed: !!processed } }));"
      },
      "executeOnce": true
    },
