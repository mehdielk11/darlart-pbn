    {
      "id": "bb000018-0000-4000-8000-000000000000",
      "name": "Themes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ],
      "parameters": {
        "jsCode": "// One theme per collection family: \"Animals\", \"Animals - Mini Kits\" and \"Animals - Kids Kits\" are the theme \"Animals\".\n// Its tag is the main collection's handle (the Kids Kits smart collections match on it, e.g. \"animals\").\nconst settings = $('Settings').first().json;\nconst response = $input.first().json;\nconst errors = (response.errors || []).map((e) => e.message);\nif (errors.length) throw new Error(\"Shopify: \" + errors.join(\"; \"));\nconst collections = ((response.data || {}).collections || {}).nodes || [];\nconst skip = new Set(String(settings.skipCollections).split(\",\").map((s) => s.trim().toLowerCase()).filter(Boolean));\nconst slug = (s) => String(s).toLowerCase().replace(/&/g, \" \").replace(/[^a-z0-9]+/g, \"-\").replace(/^-|-$/g, \"\");\nconst themes = {};\nfor (const c of collections) {\n    if (skip.has(c.title.trim().toLowerCase())) continue;\n    const name = c.title.split(\" - \")[0].trim();\n    const theme = (themes[name] = themes[name] || { name, tag: slug(name), collections: [] });\n    theme.collections.push({ id: c.id, title: c.title, handle: c.handle });\n    if (c.title.trim() === name) theme.tag = c.handle; // the main collection's handle\n}\n// only themes with a main collection (e.g. \"Animals\"): a product never goes into a Mini Kits or Kids Kits collection by hand\nconst list = Object.values(themes).filter((t) => t.collections.some((c) => c.title.trim() === t.name)).sort((a, b) => a.name.localeCompare(b.name));\nif (!list.length) throw new Error(\"No theme collections found in Shopify\");\nreturn [{ json: { themes: list, names: list.map((t) => t.name) } }];"
      }
    },
    {
      "id": "bb000019-0000-4000-8000-000000000000",
      "name": "List Artwork Agent folders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "url": "https://www.googleapis.com/drive/v3/files",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "='{{ $('Settings').first().json.agentFolderId }}' in parents and mimeType = 'application/vnd.google-apps.folder' and trashed = false"
            },
            {
              "name": "fields",
              "value": "files(id,name,mimeType)"
            },
            {
              "name": "orderBy",
              "value": "createdTime desc"
            },
            {
              "name": "pageSize",
              "value": "1000"
            },
            {
              "name": "supportsAllDrives",
              "value": "true"
            },
            {
              "name": "includeItemsFromAllDrives",
              "value": "true"
            }
          ]
        },
        "options": {
