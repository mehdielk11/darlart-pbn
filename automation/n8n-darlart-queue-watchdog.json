    {
      "id": "dd000006-0000-4000-8000-000000000000",
      "name": "Locks to check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -200
      ],
      "parameters": {
        "jsCode": "// Every lock (\"<prefix>.lock-<execution id>\") in the queue and Artwork Agent folders, a minute old or more\nconst files = [...($('List queue').first().json.files || []), ...($('List Artwork Agent').first().json.files || [])];\nconst locks = files.filter((f) => /\\.lock-\\d+$/.test(f.name) && Date.now() - new Date(f.createdTime).getTime() > 60000)\n    .map((f) => ({ json: { id: f.id, name: f.name, executionId: f.name.split(\"-\").pop() } }));\nreturn locks.length ? locks : [{ json: { none: true } }];"
      },
      "executeOnce": true
    },
    {
      "id": "dd000007-0000-4000-8000-000000000000",
      "name": "Any lock?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        -200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "anylock",
              "leftValue": "={{ !$json.none }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "dd000008-0000-4000-8000-000000000000",
      "name": "Run of the lock",
      "type": "n8n-nodes-base.n8n",
      "typeVersion": 1,
      "position": [
        1320,
        -280
      ],
      "parameters": {
        "resource": "execution",
        "operation": "get",
        "executionId": "={{ $json.executionId }}",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "dd000009-0000-4000-8000-000000000000",
      "name": "Locks of finished runs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -280
      ],
      "parameters": {
        "jsCode": "// A run that is over no longer needs its lock; a run still going (or one that cannot be checked) keeps it\nconst locks = $('Locks to check').all().map((item) => item.json);\nconst out = [];\n$input.all().forEach((item, i) => {\n    const lock = locks[i];\n    const r = item.json || {};\n    if (!lock) return;\n    if (r.error) {\n        // gone from n8n (deleted or pruned): the run is long over\n        const text = JSON.stringify(r.error);\n        if (!/credential/i.test(text) && /\b404\b|could not be found/i.test(text)) out.push({ json: { ...lock, status: \"gone\" } });\n        return;\n    }\n    const status = String(r.status || \"\");\n    if ([\"success\", \"error\", \"canceled\", \"crashed\"].includes(status)) out.push({ json: { ...lock, status } });\n});\nreturn out.length ? out : [{ json: { none: true } }];"
      }
    },
    {
      "id": "dd000010-0000-4000-8000-000000000000",
      "name": "Any to delete?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1760,
        -280
      ],
      "parameters": {
