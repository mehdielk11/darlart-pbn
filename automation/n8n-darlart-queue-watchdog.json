    {
      "id": "dd000012-0000-4000-8000-000000000000",
      "name": "Recent folders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "jsCode": "// Numbered folders created in the last recentDays days, oldest first (one empty item when there is none)\nconst settings = $('Settings').first().json;\nconst since = Date.now() - Number(settings.recentDays) * 86400000;\nconst folders = ($('List Artwork Agent').first().json.files || [])\n    .filter((f) => f.mimeType === \"application/vnd.google-apps.folder\" && /^\\d+$/.test(String(f.name).trim()) && new Date(f.createdTime).getTime() >= since)\n    .sort((a, b) => Number(a.name) - Number(b.name));\nreturn folders.length ? folders.map((f) => ({ json: { id: f.id, name: String(f.name).trim() } })) : [{ json: { none: true } }];"
      },
      "executeOnce": true
    },
    {
      "id": "dd000013-0000-4000-8000-000000000000",
      "name": "List folder files",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        100
      ],
      "parameters": {
        "url": "https://www.googleapis.com/drive/v3/files",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.none ? \"name = '__none__' and trashed = false\" : \"'\" + $json.id + \"' in parents and trashed = false\" }}"
            },
            {
              "name": "fields",
              "value": "files(name)"
            },
            {
              "name": "orderBy",
              "value": "createdTime desc"
            },
            {
              "name": "pageSize",
              "value": "1000"
            },
            {
              "name": "supportsAllDrives",
              "value": "true"
            },
            {
              "name": "includeItemsFromAllDrives",
              "value": "true"
            }
